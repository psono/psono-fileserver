FROM python:3.14-slim-trixie
ENV DEBIAN_FRONTEND=noninteractive
LABEL maintainer="Support <support@psono.com>"
COPY . /root/
WORKDIR /root

RUN mkdir -p /root/.pip && \
    echo '[global]' >> /root/.pip/pip.conf && \
    echo 'break-system-packages = true' >> /root/.pip/pip.conf && \
    apt-get update && \
    apt-get install -y \
        haveged \
        libyaml-dev \
        libpython3-dev \
        libpq-dev \
        libffi-dev \
        libssl-dev \
        postgresql-client && \
    pip3 install --no-cache-dir --upgrade setuptools pip && \
    pip3 install -r requirements.txt && \
    python3 -m pip uninstall --yes --root-user-action=ignore pip && \
    mkdir -p /root/.psono_fileserver && \
    cp /root/configs/mainconfig/settings.yaml /root/.psono_fileserver/settings.yaml && \
    sed -i s,path/to/psono-fileserver,root,g /root/.psono_fileserver/settings.yaml && \
    apt-get clean && \
    rm -Rf /root/psono/static && \
    rm -Rf /root/var && \
    rm -Rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /root/.cache

EXPOSE 80

CMD ["/bin/sh", "/root/configs/docker/cmd.sh"]
